# =====================================================================
# Root-level .env for docker-compose
# Copy to .env and fill in values
# =====================================================================

# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=nms_compliance
DB_USERNAME=nms_user
DB_PASSWORD=nms_password

# JWT (minimum 32 characters)
JWT_SECRET=your-super-secret-jwt-key-minimum-32-chars-change-this

# Encryption key for device passwords (exactly 32 chars)
ENCRYPTION_KEY=change-this-32-char-key-now!!!!

# AI Service
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=

# Internal API key between backend and AI service
BACKEND_API_KEY=internal-secret-key-change-this
