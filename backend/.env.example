# =====================================================================
# Network Compliance System — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# =====================================================================

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nms_compliance
DB_USERNAME=nms_user
DB_PASSWORD=nms_password

# --- JWT ---
JWT_SECRET=your-256-bit-secret-key-change-this-in-production-minimum-32-chars
JWT_EXPIRATION_MS=86400000

# --- Backend Server ---
SERVER_PORT=8080

# --- AI Service ---
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_ENABLED=true

# --- Scheduled Scanning ---
COMPLIANCE_SCAN_ENABLED=true
COMPLIANCE_SCAN_INTERVAL_MS=1800000

# --- Encryption (for device passwords stored in DB) ---
ENCRYPTION_KEY=change-this-32-char-encryption-key

# --- CORS ---
FRONTEND_URL=http://localhost:5173
